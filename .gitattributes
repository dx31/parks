# .NET / editorconfig piden CRLF. Sin esto, CI en Linux deja LF y `dotnet format` falla.
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.runsettings text eol=crlf
.editorconfig text eol=crlf

*.dart text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
